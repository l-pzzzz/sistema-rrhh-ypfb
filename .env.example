# Copiar a .env y ajustar. Nunca subir .env al repositorio.
# Generar valores propios; por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://localhost:8443

# MySQL 8 (docs/06: una sola base bd_rrhh). En Docker, DB_HOST lo fija docker-compose.yml.
DB_NAME=bd_rrhh
DB_USER=rrhh
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# nginx: puerto HTTPS publicado y usado en la redirección desde HTTP (8443 en desarrollo, 443 en producción).
HTTPS_PORT=8443
HTTP_PORT=8080

# Redis: caché de parámetros (compartida por Gunicorn y Celery) y broker de Celery.
# REDIS_URL y CELERY_BROKER_URL se arman con REDIS_PASSWORD (en Docker, en docker-compose.yml).
# Use una contraseña sin caracteres reservados de URL (token_urlsafe sirve).
REDIS_PASSWORD=
REDIS_HOST=127.0.0.1

# Correo para las notificaciones de respaldo (RF-25).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=rrhh@localhost

# SMTP (producción): EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend. En desarrollo se queda la consola.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Destinatarios del resumen diario de plazos CPS (RF-07, RF-08): direcciones separadas por comas.
# Vacío = las alertas solo se muestran en la bandeja.
CORREO_AFILIADORES=

# Alertas de lactancia pendiente (RF-19): direcciones separadas por comas.
CORREO_RESP_VACACIONES=

# Avisos al administrador: parámetros de planillas faltantes (RF-22) y respaldos (RF-25).
CORREO_ADMINISTRADOR=
