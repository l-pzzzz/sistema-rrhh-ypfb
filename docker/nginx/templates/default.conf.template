upstream gunicorn {
    server web:8000;
}

server {
    listen 80;
    server_name _;
    # HTTPS_PORT: 8443 en desarrollo y 443 en producción (lo sustituye envsubst al iniciar nginx).
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/rrhh.crt;
    ssl_certificate_key /etc/nginx/certs/rrhh.key;
    ssl_protocols       TLSv1.2 TLSv1.3;  # RNF-05
    ssl_ciphers         HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Documentos de hasta 5 MB (RF-04) y archivos de migración (RF-24).
    client_max_body_size 20m;

    location /static/ {
        alias /app/staticfiles/;
    }

    location / {
        proxy_pass http://gunicorn;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Se reemplaza (no se agrega) para que la IP de la bitácora no se pueda falsificar.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 300s;  # Planilla de 2.500 contratos en menos de 5 minutos (RNF-04).
    }
}
